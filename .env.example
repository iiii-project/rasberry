# 複製成 .env 後填入（任何相容 OpenAI Chat Completions 的服務都可以）
LLM_API_KEY=sk-...
# 選用：不填就使用 OpenAI 官方 API
LLM_BASE_URL=
# 選用：覆蓋 config.yaml 的 llm.model
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# 選用：語音辨識用不同的服務時才需要（預設沿用上面的 LLM_*）
# STT_API_KEY=
# STT_BASE_URL=

# 求籤後端（iiii-project-backend）的 REST API 位址，結尾是 /api/v1
# 後端的 DJANGO_ALLOWED_HOSTS 必須包含這裡的主機名稱
BACKEND_URL=https://iii.dev-serve.me/api/v1
